APP_ENV=development

# --- PostgreSQL ---
# Local dev: Postgres 16 runs in WSL; start it with `scripts/db.ps1 start`.
# Use 127.0.0.1, not localhost (WSL forwards IPv4 only). Compose overrides the host to "db".
POSTGRES_USER=datasage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datasage
DATABASE_URL=postgresql+asyncpg://datasage:change-me@127.0.0.1:5432/datasage
# Integration tests: must be a separate *_test database. Leave empty to skip DB tests.
TEST_DATABASE_URL=postgresql+asyncpg://datasage:change-me@127.0.0.1:5432/datasage_test

# --- Uploads ---
# Empty = <repo>/data. Each session gets its own subfolder.
# DATA_DIR=
MAX_UPLOAD_MB=50
PROFILE_SAMPLE_ROWS=5

# --- LLM provider: gemini | anthropic ---
LLM_PROVIDER=gemini

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Any Gemini model with function calling; check the IDs available to your key.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=16000
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=120

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
# Leave the key empty to use credentials from `ant auth login` or the environment.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Claude Opus 5.5 defaults to medium if unset)
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback: "default" = API picks the fallback model; empty = off
ANTHROPIC_FALLBACKS=default
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_MAX_RETRIES=2
# Agent guards: API calls per question; failed code runs before it gives up
AGENT_MAX_ITERATIONS=12
AGENT_MAX_CODE_ERRORS=3

# --- Sandbox (runs LLM-written code in Docker) ---
# Local dev: Docker Engine runs inside WSL; scripts/sandbox.ps1 starts it and builds the image.
SANDBOX_DOCKER=wsl -d Ubuntu-24.04 -u root -e docker
# true when SANDBOX_DOCKER is the WSL CLI, so E:\x paths are mounted as /mnt/e/x
SANDBOX_WSL_PATHS=true
SANDBOX_IMAGE=datasage-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS=64

# --- Public-instance guards ---
# Questions per client IP per hour (0 = no limit)
ASK_LIMIT_PER_HOUR=30
# Sessions and their files are deleted after this many days (0 = keep forever)
SESSION_TTL_DAYS=7
# Built frontend to serve at / (the production image sets it); empty = not served
STATIC_DIR=

# --- Frontend ---
# Where the Vite dev server proxies /api requests.
BACKEND_URL=http://localhost:8000
